{
    "id": "auto-increment",
    "source_domain": "text",
    "url": "unique",
    "title": "text",
    "date": "date",

    "scraped_at": "timestamp",
    "last_updated": "timestamp nullable",
    "author": "text nullable",
    "contact_info": "text nullable", # lmao call the copper, probably not useful for anything else (just parse phone numbers and emails maybe lol)
    "location": "text",

    "content": "text", # ==> it's own table
    "crime_type": "text",
    "keywords": "text[] or json",  # Array of tags

    "thumbnail_path": "text nullable", # 'files' table
    "image_paths": "text[] or json",  # Array of image paths,'files' table
    "video_paths": "text[] or json",  # Array of video paths,'files' table
    "file_paths": "text[] or json",  # PDFs, other files,'files' table
    "external_links": "text[] or json nullable", # 'files' table

    "raw_html": "text"  # For re-parsing
}
